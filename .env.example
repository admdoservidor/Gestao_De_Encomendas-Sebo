# Segredo do Django (gere um novo em produção)
DJANGO_SECRET_KEY=django-insecure-troque-este-valor-em-producao
# False em produção, True só para debug local via compose
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
# Ex.: https://seu-dominio.com (separados por vírgula, com https://)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Banco Postgres (usado pelo settings.py e pelo docker-compose.yml)
POSTGRES_DB=sebo
POSTGRES_USER=sebo
POSTGRES_PASSWORD=sebo123
# Dentro do compose o host é o serviço "db"; local sem Docker use localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
