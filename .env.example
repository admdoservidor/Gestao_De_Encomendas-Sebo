# Segredo do Django (gere um novo em produção)
DJANGO_SECRET_KEY=django-insecure-troque-este-valor-em-producao
# False em produção, True só para debug local via compose
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
# Ex.: https://seu-dominio.com (separados por vírgula, com https://)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Opção A: Postgres local via docker-compose (padrão) ---
POSTGRES_DB=sebo
POSTGRES_USER=sebo
POSTGRES_PASSWORD=troque-esta-senha-em-producao
# Dentro do compose o host é o serviço "db"; local sem Docker use localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Opção B: Supabase (copie do .env.local do Supabase) ---
# Quando alguma URL abaixo estiver definida, ela tem prioridade sobre a Opção A.
# sebo_POSTGRES_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# sebo_POSTGRES_PRISMA_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# As chaves abaixo são do frontend JS, o Django não usa (pode manter no .env.local):
# NEXT_PUBLIC_sebo_SUPABASE_URL=
# NEXT_PUBLIC_sebo_SUPABASE_ANON_KEY=
# sebo_SUPABASE_PUBLISHABLE_KEY=
